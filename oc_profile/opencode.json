{
  "$schema": "https://opencode.ai/config.json",
  "model": "agentsa1/deepseek-v4-flash",
  "permission": { "edit": "allow", "bash": { "ls*": "deny", "cat *": "deny", "head *": "deny", "tail *": "deny", "wc *": "deny", "*": "allow" }, "webfetch": "allow", "external_directory": "allow", "read": "deny", "glob": "deny", "list": "deny", "grep": "deny", "task": "deny" },
  "provider": {
    "agentsa1": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek V4 Flash (spark-480b, was Agents-A1 slot)",
      "options": {
        "baseURL": "http://192.168.86.32:8000/v1",
        "apiKey": "EMPTY"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": { "context": 32768, "output": 16384 },
          "options": { "temperature": 0.1, "reasoningEffort": "none" }
        },
        "Agents-A1": {
          "name": "Agents-A1 (alias -> current spark backend)",
          "limit": { "context": 32768, "output": 16384 },
          "options": { "temperature": 0.1, "reasoningEffort": "none" }
        }
      }
    }
  }
}
